# Copy to .env and fill in. .env is gitignored; never commit it.
# Used by: ziot_fake_cloud.py --provision (reads WIFI_PWD from .env)

# The camera's WiFi credentials -- sent to the camera over BLE only.
WIFI_SSID=House of Cats
WIFI_PWD=

# The camera's BLE advertising address (ZIOTA_<uid>).
BLE_MAC=E0:44:40:60:68:82

# Where the camera should register (default: this host's broker).
# SIG_ADDR=192.168.68.114:8882
