# Local ZIOT cloud broker, run as a service.
#
# The camera reaches the vendor cloud through fixed addresses, and
# `--claim-ips` makes this host own them; a static route in the router then
# sends the camera's cloud traffic here. See README.md, "Taking the camera
# off the vendor cloud".
#
# Install:
#   sudo cp ziot-broker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ziot-broker.service
#
# The API listens on the vendor's port 80, which needs privileges. Rather
# than running as root -- which would put the log file out of reach --
# the capability is granted to the service instead, so the broker stays an
# ordinary user process and the log stays readable.

[Unit]
Description=Local ZIOT cloud broker (API + signalling + STUN + websocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
PrivateTmp=no
User=mauriciobc
Group=mauriciobc
WorkingDirectory=/home/mauriciobc/Documentos/Code/ziot-rtp-bridge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /home/mauriciobc/Documentos/Code/ziot-rtp-bridge/ziot_fake_cloud.py --http 80 --sig 8882 --stun 13478 --ws 7080 --dns 53 --upstream-dns 1.1.1.1 --bind-ip 192.168.68.114 --log /home/mauriciobc/ziot-broker.log
StandardOutput=append:/home/mauriciobc/ziot-broker.out
StandardError=append:/home/mauriciobc/ziot-broker.err
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
